CONFIG_MAV_ROLE_DRONE=y

# GPIO43/44 carry the MAVLink UART to the FC, so keep the console (logs) off
# them: logs go to the USB port only.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# WPA2 key shared by both boards (must be identical in both *.defaults files)
CONFIG_MAV_WIFI_PASS="2Tizdqnvajy1rwrI"
